# Edge Function secrets (set with `supabase secrets set`, never commit real values)
APP_ENV=test                 # test | production
MODERATION_PROVIDER=gemini   # gemini | openai
MODERATION_TIER=free         # free | paid  — production REFUSES free (fail closed)
MODERATION_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
# Luna determinism (OpenAI only). Unset = model default reasoning, fixed seed only (current behaviour).
# "none" = reasoning_effort none + temperature 0 (most repeatable; evaluate quality on the test corpus before enabling).
# gpt-6 models reject temperature at any other effort, so temperature is only ever sent together with "none".
OPENAI_REASONING_EFFORT=
# Second Luna check for messages the first check allows; block if either blocks. Default OFF.
# Cost: about 2x model tokens for allowed messages. Latency: about +3-7 s per allowed message (one extra call).
MODERATION_DOUBLE_CHECK=off
